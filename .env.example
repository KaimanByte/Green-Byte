DATABASE_URL=postgresql://postgres:postgres@postgres:5432/green_byte
# Autenticação (obrigatórias: o backend não sobe sem elas)
# JWT_SECRET assina os tokens de login; ADM_EMAIL e ADM_PASSWORD criam o administrador
# inicial quando o banco ainda não tem usuários. Troque os valores fora do ambiente local.
JWT_SECRET=your_super_secret_key_change_me
ADM_EMAIL=admin@greenbyte.com
ADM_PASSWORD=admin_password
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Coleta automática: intervalo em segundos (inteiro entre 1 e 2147483).
COLLECTION_INTERVAL_SECONDS=30

# APIs externas da GreenER (obrigatórias: o backend não sobe sem elas)
METRICS_API_BASE_URL=https://metrics.unilaunch.org
CARBON_API_BASE_URL=https://carbon.unilaunch.org
